# ==============================================================================
# EduKadence - Environment Configuration Template
# Copy this file to .env and configure for your local/staging/production setup.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=edukadence-insecure-dev-secret-key-change-in-production-1234567890
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production / Docker; defaults to SQLite in local dev if unset)
# Example PostgreSQL: postgresql://edukadence_user:edukadence_password@localhost:5432/edukadence_db
DATABASE_URL=
DB_NAME=edukadence_db
DB_USER=edukadence_user
DB_PASSWORD=edukadence_password
DB_HOST=localhost
DB_PORT=5432

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
